import { Theme, Feedback } from "theme.slint";

export enum KeyKind { number, operator, primary }

// The IR pulse: an accent ripple from the finger and a fading accent ring, ~400 ms.
export component Pulse inherits Rectangle {
    in property <bool> pulsing;
    in property <duration> start;
    in property <length> px;
    in property <length> py;
    in property <length> radius: Theme.radius;
    // The fading ring around the whole element (off for shapes that aren't one rectangle).
    in property <bool> ring: true;
    property <float> t: root.pulsing ? clamp((animation-tick() - root.start) / 380ms, 0, 1) : 1;
    property <float> e: 1 - (1 - root.t) * (1 - root.t);
    property <length> d: (root.width + root.height) * 1.25 * root.e;

    if root.pulsing: Rectangle {
        x: root.px - root.d / 2;
        y: root.py - root.d / 2;
        width: root.d;
        height: root.d;
        border-radius: root.d / 2;
        background: Theme.accent;
        opacity: (1 - root.t) * 0.38;
    }
    if root.pulsing && root.ring: Rectangle {
        border-radius: root.radius;
        border-width: 2px;
        border-color: Theme.accent;
        opacity: 1 - root.t;
    }
}


// One key: numbers sit almost flush with the page, operators lift a step lighter,
// and the primary key (OK, GO, Rescan) inverts to the ink color, like Omacalc's `=`.
export component Key inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <KeyKind> kind: KeyKind.number;
    in property <length> font-size: 20px;
    in property <length> icon-size: 26px;
    in property <bool> long-press-enabled: false;
    callback clicked;
    callback long-pressed;
    callback pressed;
    callback released;
    property <bool> pulsing;
    property <duration> pulse-start;
    property <bool> long-press-fired;

    clip: true;
    border-radius: Theme.radius;
    border-width: root.kind == KeyKind.number ? 1px : 0px;
    border-color: Theme.key-border;
    background: root.kind == KeyKind.primary ? (touch.pressed ? Theme.primary-pressed : Theme.fg)
        : root.kind == KeyKind.operator ? (touch.pressed ? Theme.operator-pressed : Theme.operator)
        : (touch.pressed ? Theme.key-pressed : Theme.key);
    animate background { duration: 90ms; }

    Pulse { pulsing: root.pulsing; start: root.pulse-start; px: touch.pressed-x; py: touch.pressed-y; }
    if !root.has-icon: Text {
        text: root.label;
        color: root.kind == KeyKind.primary ? Theme.bg : Theme.fg;
        font-size: root.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.has-icon: Image {
        source: root.icon;
        colorize: root.kind == KeyKind.primary ? Theme.bg : Theme.fg;
        width: root.icon-size;
        height: root.icon-size;
    }
    touch := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.long-press-fired = false;
                Feedback.tap();
                root.pressed();
                if Feedback.ir {
                    root.pulse-start = animation-tick();
                    root.pulsing = true;
                }
            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                root.released();
            }
        }
        clicked => {
            if root.long-press-fired {
                root.long-press-fired = false;
            } else {
                root.clicked();
            }
        }
    }
    Timer {
        interval: 700ms;
        running: root.long-press-enabled && touch.pressed && !root.long-press-fired;
        triggered => {
            root.long-press-fired = true;
            root.long-pressed();
        }
    }
    Timer { interval: 420ms; running: root.pulsing; triggered => { root.pulsing = false; } }
}

// A tall rocker (VOL, CH): + on top, its name in the middle, − at the bottom.
export component Rocker inherits Rectangle {
    in property <string> label;
    callback up;
    callback down;

    property <bool> pulsing;
    property <duration> pulse-start;
    property <length> px;
    property <length> py;

    clip: true;
    border-radius: Theme.radius;
    background: Theme.operator;

    Rectangle {
        y: 0;
        height: parent.height / 2;
        border-radius: Theme.radius;
        background: top.pressed ? Theme.operator-pressed : transparent;
        Text { y: 16px; text: "+"; color: Theme.fg; font-size: 22px; }
        top := TouchArea {
            pointer-event(e) => { if e.kind == PointerEventKind.down { root.tapped(self.mouse-x, self.mouse-y); } }
            clicked => { root.up(); }
        }
    }
    Rectangle {
        y: parent.height / 2;
        height: parent.height / 2;
        border-radius: Theme.radius;
        background: bottom.pressed ? Theme.operator-pressed : transparent;
        Text { y: parent.height - self.height - 16px; text: "−"; color: Theme.fg; font-size: 22px; }
        bottom := TouchArea {
            pointer-event(e) => { if e.kind == PointerEventKind.down { root.tapped(self.mouse-x, parent.height + self.mouse-y); } }
            clicked => { root.down(); }
        }
    }
    Pulse { pulsing: root.pulsing; start: root.pulse-start; px: root.px; py: root.py; }
    Timer { interval: 420ms; running: root.pulsing; triggered => { root.pulsing = false; } }

    function tapped(x: length, y: length) {
        Feedback.tap();
        if Feedback.ir {
            root.px = x;
            root.py = y;
            root.pulse-start = animation-tick();
            root.pulsing = true;
        }
    }
    Text { text: root.label; color: Theme.muted; font-size: 13px; }
}

// Three offset lines, top right, like Omacalc's menu button.
export component Hamburger inherits Rectangle {
    callback clicked;
    width: 44px;
    height: 44px;
    VerticalLayout {
        alignment: center;
        spacing: 6px;
        for w in [30px, 22px, 30px]: HorizontalLayout {
            alignment: end;
            Rectangle { width: w; height: 2px; border-radius: 1px; background: Theme.fg; opacity: 0.55; }
        }
    }
    TouchArea {
        pointer-event(e) => { if e.kind == PointerEventKind.down { Feedback.tap(); } }
        clicked => { root.clicked(); }
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

// The page title, an optional subtitle with the accent dot, and the menu button.
// With `tappable`, a tap on the title (a device's name) goes back to the devices list.
export component Header inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> online: false;
    in property <bool> tappable: false;
    callback menu;
    callback title-clicked;

    padding-left: 8px;
    padding-right: 8px;
    padding-top: 18px;
    padding-bottom: 6px;
    VerticalLayout {
        spacing: 6px;
        alignment: center;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            title := Text {
                text: root.title;
                color: Theme.fg;
                font-size: 21px;
                overflow: elide;
                TouchArea {
                    enabled: root.tappable;
                    pointer-event(e) => { if e.kind == PointerEventKind.down { Feedback.tap(); } }
                    clicked => { root.title-clicked(); }
                }
            }
        }
        if root.subtitle != "": HorizontalLayout {
            spacing: 10px;
            alignment: start;
            if root.online: VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; } }
            Text { text: root.subtitle; color: Theme.muted; font-size: 14px; overflow: elide; }
        }
    }
    Hamburger { clicked => { root.menu(); } }
}

// "Are you sure?" over the whole page: a dimmed backdrop and a card with Cancel and a primary action.
export component Confirm inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> action: @tr("Delete");
    callback confirmed;
    callback cancelled;

    background: Theme.bg.with-alpha(0.82);
    // Swallow taps on the backdrop: tapping outside the card cancels.
    TouchArea { clicked => { root.cancelled(); } }
    card := Rectangle {
        width: min(root.width - 32px, 420px);
        height: body.preferred-height;
        border-radius: Theme.radius;
        background: Theme.bg;
        border-width: 1px;
        border-color: Theme.divider;
        TouchArea { }
        body := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            Text { text: root.title; color: Theme.fg; font-size: 22px; wrap: word-wrap; }
            Text { text: root.message; color: Theme.muted; font-size: 15px; wrap: word-wrap; }
            HorizontalLayout {
                height: 56px;
                spacing: Theme.gap;
                Key { label: @tr("Cancel"); kind: KeyKind.operator; font-size: 17px; clicked => { root.cancelled(); } }
                Key { label: root.action; kind: KeyKind.primary; font-size: 17px; clicked => { root.confirmed(); } }
            }
        }
    }
}

// One arrow of the round D-pad: a quarter of the ring around OK, centred on `angle`
// (0° right, 90° down), drawn as an annular sector with a small gap on each side.
component RingSegment inherits Rectangle {
    in property <angle> angle;
    in property <length> outer;
    in property <length> inner;
    in property <bool> down;
    in property <image> icon;
    property <angle> half: 45deg - 4deg;
    property <float> cx: root.width / 2px;
    property <float> cy: root.height / 2px;
    property <float> ro: root.outer / 1px;
    property <float> ri: root.inner / 1px;

    Path {
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        fill: root.down ? Theme.key-pressed : Theme.key;
        stroke: Theme.key-border;
        stroke-width: 1px;
        MoveTo { x: root.cx + root.ro * cos(root.angle - root.half); y: root.cy + root.ro * sin(root.angle - root.half); }
        ArcTo { x: root.cx + root.ro * cos(root.angle + root.half); y: root.cy + root.ro * sin(root.angle + root.half); radius-x: root.ro; radius-y: root.ro; sweep: true; }
        LineTo { x: root.cx + root.ri * cos(root.angle + root.half); y: root.cy + root.ri * sin(root.angle + root.half); }
        ArcTo { x: root.cx + root.ri * cos(root.angle - root.half); y: root.cy + root.ri * sin(root.angle - root.half); radius-x: root.ri; radius-y: root.ri; sweep: false; }
        Close { }
    }
    Image {
        property <length> mid: (root.outer + root.inner) / 2;
        x: root.width / 2 + self.mid * cos(root.angle) - self.width / 2;
        y: root.height / 2 + self.mid * sin(root.angle) - self.height / 2;
        width: 28px;
        height: 28px;
        source: root.icon;
        colorize: Theme.fg;
    }
}

// The D-pad: OK in the middle, an arrow on each side. Two looks, one touch area:
// boxy keys (like the rest of the remote) or a round OK inside a ring of four arrows.
// Swipe left for the round one, right for the boxy one; `style-changed` saves the choice.
export component DPad inherits Rectangle {
    in-out property <bool> round;
    // A shorter swipe, or more vertical than sideways, is a press, not a style change.
    in property <length> swipe: 56px;
    callback press(string);
    callback style-changed(bool);

    property <length> gap: Theme.gap;
    property <length> cell-w: (root.width - 2 * self.gap) / 3;
    property <length> cell-h: (root.height - 2 * self.gap) / 3;
    property <length> outer: min(root.width, root.height) / 2 - 2px;
    property <length> inner: self.outer * 0.42;
    // The part under the finger ("" outside every key), and whether the finger is swiping.
    property <string> part;
    property <bool> swiping;
    property <bool> pulsing;
    property <duration> pulse-start;

    // Boxy: the five keys of a 3 × 3 grid.
    if !root.round: Rectangle {
        for k[i] in [
            { id: "up", col: 1, row: 0 },
            { id: "left", col: 0, row: 1 },
            { id: "ok", col: 1, row: 1 },
            { id: "right", col: 2, row: 1 },
            { id: "down", col: 1, row: 2 },
        ]: Rectangle {
            x: k.col * (root.cell-w + root.gap);
            y: k.row * (root.cell-h + root.gap);
            width: root.cell-w;
            height: root.cell-h;
            border-radius: Theme.radius;
            border-width: k.id == "ok" ? 0px : 1px;
            border-color: Theme.key-border;
            background: k.id == "ok"
                ? (root.part == "ok" ? Theme.primary-pressed : Theme.fg)
                : (root.part == k.id ? Theme.key-pressed : Theme.key);
            animate background { duration: 90ms; }
            if k.id == "ok": Text { text: @tr("OK"); color: Theme.bg; font-size: 22px; }
            if k.id != "ok": Image {
                width: 30px;
                height: 30px;
                colorize: Theme.fg;
                source: k.id == "up" ? @image-url("icons/up.svg")
                    : k.id == "down" ? @image-url("icons/down.svg")
                    : k.id == "left" ? @image-url("icons/left.svg")
                    : @image-url("icons/right.svg");
            }
        }
    }

    // Round: a ring of four arcs around a round OK.
    if root.round: Rectangle {
        RingSegment { angle: 270deg; outer: root.outer; inner: root.inner + root.gap / 2; down: root.part == "up"; icon: @image-url("icons/up.svg"); }
        RingSegment { angle: 0deg; outer: root.outer; inner: root.inner + root.gap / 2; down: root.part == "right"; icon: @image-url("icons/right.svg"); }
        RingSegment { angle: 90deg; outer: root.outer; inner: root.inner + root.gap / 2; down: root.part == "down"; icon: @image-url("icons/down.svg"); }
        RingSegment { angle: 180deg; outer: root.outer; inner: root.inner + root.gap / 2; down: root.part == "left"; icon: @image-url("icons/left.svg"); }
        Rectangle {
            width: root.inner * 2 - root.gap / 2;
            height: self.width;
            border-radius: self.width / 2;
            background: root.part == "ok" ? Theme.primary-pressed : Theme.fg;
            animate background { duration: 90ms; }
            Text { text: @tr("OK"); color: Theme.bg; font-size: 22px; }
        }
    }

    Pulse { ring: false; pulsing: root.pulsing; start: root.pulse-start; px: touch.pressed-x; py: touch.pressed-y; }
    Timer { interval: 420ms; running: root.pulsing; triggered => { root.pulsing = false; } }

    touch := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.swiping = false;
                root.part = root.part-at(self.mouse-x, self.mouse-y);
                if root.part != "" {
                    Feedback.tap();
                    if Feedback.ir {
                        root.pulse-start = animation-tick();
                        root.pulsing = true;
                    }
                }
            } else if e.kind == PointerEventKind.up {
                let dx = self.mouse-x - self.pressed-x;
                if root.swiping {
                    if dx < -root.swipe && !root.round {
                        root.round = true;
                        root.style-changed(true);
                    } else if dx > root.swipe && root.round {
                        root.round = false;
                        root.style-changed(false);
                    }
                } else if root.part != "" && root.part == root.part-at(self.mouse-x, self.mouse-y) {
                    root.press(root.part);
                }
                root.part = "";
                root.swiping = false;
            } else if e.kind == PointerEventKind.cancel {
                root.part = "";
                root.swiping = false;
            }
        }
        moved => {
            if !root.swiping && abs(self.mouse-x - self.pressed-x) > 24px && abs(self.mouse-x - self.pressed-x) > 2 * abs(self.mouse-y - self.pressed-y) {
                root.swiping = true;
                root.part = "";
            }
        }
    }

    // Which key is at (x, y): OK's circle and the ring's four quarters, or the 3 × 3 grid.
    function part-at(x: length, y: length) -> string {
        if root.round {
            let dx = (x - root.width / 2) / 1px;
            let dy = (y - root.height / 2) / 1px;
            let d = sqrt(dx * dx + dy * dy);
            if d <= root.inner / 1px { return "ok"; }
            if d > root.outer / 1px { return ""; }
            if abs(dx) > abs(dy) { return dx > 0 ? "right" : "left"; }
            return dy > 0 ? "down" : "up";
        }
        if x < 0px || y < 0px || x >= root.width || y >= root.height { return ""; }
        let col = floor(x / (root.cell-w + root.gap));
        let row = floor(y / (root.cell-h + root.gap));
        if col == 1 && row == 0 { return "up"; }
        if col == 1 && row == 2 { return "down"; }
        if col == 0 && row == 1 { return "left"; }
        if col == 2 && row == 1 { return "right"; }
        if col == 1 && row == 1 { return "ok"; }
        return "";
    }
}
