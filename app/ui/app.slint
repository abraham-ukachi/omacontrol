import "fonts/iAWriterMonoS-Regular.ttf";
import { Theme, Feedback } from "theme.slint";
import { DevicesPage, DeviceRow } from "devices.slint";
import { RemotePage } from "remote.slint";
import { KeypadPage } from "keypad.slint";
import { MenuPage } from "menu.slint";
import { AcPage, AcSetupPage } from "ac.slint";

export { Theme, Feedback, DeviceRow }

// Pages: 0 Devices · 1 Remote · 2 Channels & apps · 3 Menu · 4 AC · 5 AC setup
export component AppWindow inherits Window {
    title: "OmaControl";
    preferred-width: 400px;
    preferred-height: 868px;
    background: Theme.bg;
    default-font-family: "iA Writer Mono S";

    in-out property <int> page: 0;
    property <int> back-page: 0;
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;

    in property <[DeviceRow]> devices;
    in property <bool> scanning;
    in property <string> subnet: "your network";
    in property <string> tv-name: "No TV";
    in property <string> tv-status: "pick a TV";
    in property <bool> online;
    in property <[string]> apps;
    in property <[string]> themes;
    in property <string> version;
    in property <bool> has-ir;

    // The air conditioner (when the current device is one).
    in property <bool> current-is-ac;
    in property <string> ac-name;
    in property <string> ac-status;
    in property <bool> ac-power;
    in property <int> ac-temp: 22;
    in property <string> ac-mode: "cool";
    in property <string> ac-fan: "low";
    in property <bool> ac-swing;
    in property <bool> ac-sleep;
    in property <string> ac-setup-protocol;
    in property <int> ac-setup-index;
    in property <int> ac-setup-count: 10;
    in property <bool> ac-setup-tested;

    callback rescan;
    callback pick(int);
    callback add-ip(string);
    callback add-ir(string);
    callback press(string);
    callback launch(string);
    callback send-text(string);
    callback pick-theme(string);
    callback add-ac();
    callback ac-action(string);
    callback ac-setup(string);
    callback ac-code-changed(string);

    function open-menu() {
        root.back-page = root.page;
        root.page = 3;
    }

    Rectangle {
        x: 20px;
        property <length> top: max(root.inset-top, root.safe-area-insets.top);
        property <length> bottom: max(root.inset-bottom, root.safe-area-insets.bottom);
        y: self.top + 8px;
        width: root.width - 40px;
        height: root.height - self.top - self.bottom - 28px;

        if root.page == 0: DevicesPage {
            devices: root.devices;
            scanning: root.scanning;
            subnet: root.subnet;
            menu => { root.open-menu(); }
            pick(i) => { root.pick(i); }
            rescan => { root.rescan(); }
            add-ip(ip) => { root.add-ip(ip); }
            has-ir: root.has-ir;
            add-ir(b) => { root.add-ir(b); }
            add-ac => { root.add-ac(); }
        }
        if root.page == 1: RemotePage {
            tv-name: root.tv-name;
            tv-status: root.tv-status;
            online: root.online;
            menu => { root.open-menu(); }
            press(k) => { root.press(k); }
            keypad => { root.page = 2; }
            keyboard => { root.page = 2; }
        }
        if root.page == 2: KeypadPage {
            tv-name: root.tv-name;
            apps: root.apps;
            menu => { root.open-menu(); }
            press(k) => { root.press(k); }
            launch(a) => { root.launch(a); }
            send-text(t) => { root.send-text(t); }
            kb-top: root.virtual-keyboard-position.y;
            kb-height: root.virtual-keyboard-size.height;
        }
        if root.page == 4: AcPage {
            name: root.ac-name;
            status: root.ac-status;
            power: root.ac-power;
            temp: root.ac-temp;
            mode: root.ac-mode;
            fan: root.ac-fan;
            swing: root.ac-swing;
            sleep: root.ac-sleep;
            menu => { root.open-menu(); }
            action(a) => { root.ac-action(a); }
        }
        if root.page == 5: AcSetupPage {
            protocol: root.ac-setup-protocol;
            index: root.ac-setup-index;
            count: root.ac-setup-count;
            tested: root.ac-setup-tested;
            menu => { root.open-menu(); }
            setup(s) => { root.ac-setup(s); }
            code-changed(t) => { root.ac-code-changed(t); }
        }
        if root.page == 3: MenuPage {
            themes: root.themes;
            version: root.version;
            close => { root.page = root.back-page; }
            goto(i) => { root.page = i == 1 && root.current-is-ac ? 4 : i; }
            pick-theme(t) => { root.pick-theme(t); }
        }
    }
}
