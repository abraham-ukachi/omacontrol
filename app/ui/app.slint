import "fonts/iAWriterMonoS-Regular.ttf";
import { Theme, Feedback } from "theme.slint";
import { DevicesPage, DeviceRow } from "devices.slint";
import { RemotePage } from "remote.slint";
import { KeypadPage, ChannelRow } from "keypad.slint";
import { MenuPage } from "menu.slint";
import { AcPage, AcSetupPage, AcLearned } from "ac.slint";
import { SettingsPage } from "settings.slint";

export { Theme, Feedback, DeviceRow, ChannelRow, AcLearned }

// Pages: 0 Devices · 1 Remote · 2 Channels & apps · 3 Menu · 4 AC · 5 AC setup · 6 Settings
export component AppWindow inherits Window {
    title: "OmaControl";
    preferred-width: 400px;
    preferred-height: 868px;
    background: Theme.bg;
    default-font-family: "iA Writer Mono S";

    in-out property <int> page: 0;
    property <int> back-page: 0;
    in-out property <bool> archived-view: false;
    in property <length> inset-top: 0px;
    in property <length> inset-bottom: 0px;

    in property <[DeviceRow]> devices;
    in property <bool> scanning;
    in property <string> subnet: "your network";
    in property <string> tv-name: @tr("No TV");
    in property <string> tv-status-code: "pick-tv";
    in property <string> tv-status-detail;
    in property <bool> online;
    in property <bool> voice-supported;
    in-out property <bool> voice-active;
    in-out property <string> voice-status-code;
    in-out property <string> voice-status-detail;
    in property <[string]> apps;
    in property <[string]> themes;
    in property <[string]> languages;
    in-out property <string> language: "system";
    in property <string> version;
    in property <bool> has-ir;

    // Channels saved by name for the current TV, and Android TV pairing.
    in property <[ChannelRow]> channels;
    in property <bool> pairing;

    // Settings › Feedback.
    in-out property <int> settings-tab: 0;
    in-out property <string> fb-kind: "Feedback";
    in-out property <string> fb-email;
    in-out property <string> fb-title;
    in-out property <string> fb-message;
    in property <string> fb-status-code;
    in property <string> fb-status-detail;
    in property <bool> fb-sending;

    // The air conditioner (when the current device is one).
    in property <bool> current-is-ac;
    in property <string> ac-name;
    in property <string> ac-status;
    in property <bool> ac-status-error;
    in property <bool> ac-power-only;
    in property <bool> ac-nec;
    in property <AcLearned> ac-learned;
    in property <string> ac-learning;
    in property <bool> ac-power;
    in property <int> ac-temp: 22;
    in property <string> ac-mode: "cool";
    in property <string> ac-fan: "low";
    in property <bool> ac-swing;
    in property <bool> ac-sleep;
    in property <string> ac-setup-protocol;
    in property <string> ac-setup-error;
    in property <int> ac-setup-index;
    in property <int> ac-setup-count: 10;
    in property <bool> ac-setup-tested;
    in property <bool> ac-scan-active;
    in property <bool> ac-scan-finished;
    in property <bool> ac-scan-cancelled;
    in property <int> ac-scan-count;
    in property <int> ac-scan-total;
    in-out property <int> ac-scan-index;
    in-out property <bool> ac-scan-review;
    in property <string> ac-scan-code;
    in property <string> ac-scan-result;

    callback rescan;
    callback pick(string);
    callback add-ip(string);
    callback add-ir(string);
    callback press(string);
    callback launch(string);
    callback send-text(string);
    callback pick-theme(string);
    callback pick-language(string);
    callback add-ac();
    callback ac-action(string);
    callback ac-setup(string);
    callback ac-scan-cancel();
    callback ac-scan-navigate(int);
    callback ac-code-changed(string);
    callback tune(string);
    callback save-channel(string, string);
    callback remove-channel(string);
    callback pair(string);
    callback cancel-pair();
    callback open-url(string);
    callback send-feedback();
    callback set-archived-view(bool);
    callback archive-device(string, bool);
    callback remove-device(string);
    callback rename-device(string, string);
    callback move-device(string, int);
    callback voice-start();
    callback voice-stop();

    function open-menu() {
        root.back-page = root.page;
        root.page = 3;
    }

    Rectangle {
        x: 20px;
        property <length> top: max(root.inset-top, root.safe-area-insets.top);
        property <length> bottom: max(root.inset-bottom, root.safe-area-insets.bottom);
        y: self.top + 8px;
        width: root.width - 40px;
        height: root.height - self.top - self.bottom - 28px;

        if root.page == 0: DevicesPage {
            devices: root.devices;
            scanning: root.scanning;
            subnet: root.subnet;
            archived-view <=> root.archived-view;
            kb-top: root.virtual-keyboard-position.y;
            kb-height: root.virtual-keyboard-size.height;
            menu => { root.open-menu(); }
            pick(i) => { root.pick(i); }
            rescan => { root.rescan(); }
            add-ip(ip) => { root.add-ip(ip); }
            has-ir: root.has-ir;
            add-ir(b) => { root.add-ir(b); }
            add-ac => { root.add-ac(); }
            set-archived-view(value) => { root.set-archived-view(value); }
            archive-device(id, archived) => { root.archive-device(id, archived); }
            remove-device(id) => { root.remove-device(id); }
            rename-device(id, name) => { root.rename-device(id, name); }
            move-device(id, steps) => { root.move-device(id, steps); }
        }
        if root.page == 1: RemotePage {
            tv-name: root.tv-name;
            tv-status-code: root.tv-status-code;
            tv-status-detail: root.tv-status-detail;
            online: root.online;
            voice-supported: root.voice-supported;
            voice-active: root.voice-active;
            voice-status-code: root.voice-status-code;
            voice-status-detail: root.voice-status-detail;
            menu => { root.open-menu(); }
            press(k) => { root.press(k); }
            keypad => { root.page = 2; }
            keyboard => { root.page = 2; }
            voice-start => { root.voice-start(); }
            voice-stop => { root.voice-stop(); }
            devices => { root.page = 0; }
            pairing: root.pairing;
            pair(c) => { root.pair(c); }
            cancel-pair => { root.cancel-pair(); }
            kb-height: root.virtual-keyboard-size.height;
        }
        if root.page == 2: KeypadPage {
            tv-name: root.tv-name;
            apps: root.apps;
            menu => { root.open-menu(); }
            press(k) => { root.press(k); }
            launch(a) => { root.launch(a); }
            send-text(t) => { root.send-text(t); }
            devices => { root.page = 0; }
            channels: root.channels;
            tune(n) => { root.tune(n); }
            save-channel(n, name) => { root.save-channel(n, name); }
            remove-channel(n) => { root.remove-channel(n); }
            kb-top: root.virtual-keyboard-position.y;
            kb-height: root.virtual-keyboard-size.height;
        }
        if root.page == 4: AcPage {
            name: root.ac-name;
            status: root.ac-status;
            status-error: root.ac-status-error;
            power-only: root.ac-power-only;
            nec: root.ac-nec;
            learned: root.ac-learned;
            learning: root.ac-learning;
            scan-active: root.ac-scan-active;
            scan-finished: root.ac-scan-finished;
            scan-cancelled: root.ac-scan-cancelled;
            scan-count: root.ac-scan-count;
            scan-total: root.ac-scan-total;
            scan-index: root.ac-scan-index;
            scan-review: root.ac-scan-review;
            scan-code: root.ac-scan-code;
            scan-result: root.ac-scan-result;
            setup(step) => { root.ac-setup(step); }
            scan-cancel => { root.ac-scan-cancel(); }
            scan-navigate(d) => { root.ac-scan-navigate(d); }
            power: root.ac-power;
            temp: root.ac-temp;
            mode: root.ac-mode;
            fan: root.ac-fan;
            swing: root.ac-swing;
            sleep: root.ac-sleep;
            menu => { root.open-menu(); }
            action(a) => { root.ac-action(a); }
            devices => { root.page = 0; }
        }
        if root.page == 5: AcSetupPage {
            protocol: root.ac-setup-protocol;
            setup-error: root.ac-setup-error;
            index: root.ac-setup-index;
            count: root.ac-setup-count;
            tested: root.ac-setup-tested;
            scan-active: root.ac-scan-active;
            scan-finished: root.ac-scan-finished;
            scan-cancelled: root.ac-scan-cancelled;
            scan-count: root.ac-scan-count;
            scan-total: root.ac-scan-total;
            scan-index <=> root.ac-scan-index;
            scan-review <=> root.ac-scan-review;
            scan-code: root.ac-scan-code;
            scan-result: root.ac-scan-result;
            menu => { root.open-menu(); }
            setup(s) => { root.ac-setup(s); }
            scan-cancel => { root.ac-scan-cancel(); }
            scan-navigate(i) => { root.ac-scan-navigate(i); }
            code-changed(t) => { root.ac-code-changed(t); }
            kb-top: root.virtual-keyboard-position.y;
            kb-height: root.virtual-keyboard-size.height;
        }
        if root.page == 3: MenuPage {
            version: root.version;
            close => { root.page = root.back-page; }
            goto(i) => { root.page = i == 1 && root.current-is-ac ? 4 : i; }
        }
        if root.page == 6: SettingsPage {
            themes: root.themes;
            languages: root.languages;
            language <=> root.language;
            version: root.version;
            tab <=> root.settings-tab;
            menu => { root.open-menu(); }
            pick-theme(t) => { root.pick-theme(t); }
            pick-language(l) => { root.pick-language(l); }
            open-url(u) => { root.open-url(u); }
            fb-kind <=> root.fb-kind;
            fb-email <=> root.fb-email;
            fb-title <=> root.fb-title;
            fb-message <=> root.fb-message;
            fb-status-code: root.fb-status-code;
            fb-status-detail: root.fb-status-detail;
            fb-sending: root.fb-sending;
            send-feedback => { root.send-feedback(); }
            kb-height: root.virtual-keyboard-size.height;
        }
    }
}
