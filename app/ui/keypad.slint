import { Theme, Feedback } from "theme.slint";
import { Key, KeyKind, Header, Divider, Confirm } from "widgets.slint";

export struct ChannelRow {
    number: string,
    name: string,
}

// A saved channel: tap tunes it, long-press edits its name, swipe up deletes it.
// The chip row scrolls sideways by dragging the chips themselves.
component ChannelChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback tapped;
    callback long-pressed;
    callback swiped-up;
    // Sideways drags scroll the row: start, then each move in absolute x.
    callback scroll-start;
    callback scroll-by(length);

    // 0 = undecided, 1 = scrolling sideways, 2 = swiping up, 3 = long-pressed.
    property <int> mode: 0;
    property <length> start-x;
    property <length> lift: root.mode == 2 ? clamp(touch.pressed-y - touch.mouse-y, 0px, 44px) : 0px;
    property <length> threshold: 10px;

    width: max(84px, label-text.preferred-width + 28px);
    border-radius: Theme.radius;
    background: transparent;

    Rectangle {
        y: -root.lift;
        width: root.width;
        height: root.height;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: root.selected ? Theme.accent : Theme.key-border;
        background: touch.pressed && root.mode != 1 ? Theme.key-pressed : Theme.key;
        opacity: 1 - root.lift / 88px;
        animate background { duration: 90ms; }
        label-text := Text {
            text: root.label;
            color: Theme.fg;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.mode = 0;
                root.start-x = self.absolute-position.x + self.mouse-x;
                Feedback.tap();
            } else if e.kind == PointerEventKind.up {
                if root.mode == 0 {
                    root.tapped();
                } else if root.mode == 2 && touch.pressed-y - touch.mouse-y > 36px {
                    root.swiped-up();
                }
                root.mode = 0;
            } else if e.kind == PointerEventKind.cancel {
                root.mode = 0;
            }
        }
        moved => {
            if root.mode == 0 {
                if abs(self.mouse-x - self.pressed-x) > root.threshold && abs(self.mouse-x - self.pressed-x) >= abs(self.mouse-y - self.pressed-y) {
                    root.mode = 1;
                    root.start-x = self.absolute-position.x + self.mouse-x;
                    root.scroll-start();
                } else if self.pressed-y - self.mouse-y > root.threshold {
                    root.mode = 2;
                } else if abs(self.mouse-y - self.pressed-y) > root.threshold {
                    // A downward drag does nothing; don't treat the release as a tap.
                    root.mode = 4;
                }
            }
            if root.mode == 1 {
                root.scroll-by(self.absolute-position.x + self.mouse-x - root.start-x);
            }
        }
    }
    Timer {
        interval: 480ms;
        running: touch.pressed && root.mode == 0;
        triggered => {
            root.mode = 3;
            Feedback.tap();
            root.long-pressed();
        }
    }
}

// 03 · Channels, apps & typing.
export component KeypadPage inherits Rectangle {
    in property <string> tv-name;
    // Channels saved by name (4002 → BFMTV): tap one to tune, "+ save" names the number typed.
    in property <[ChannelRow]> channels;
    callback tune(string);
    callback save-channel(string, string);
    callback remove-channel(string);
    callback devices;
    property <bool> naming: false;
    // The channel being renamed after a long-press ("" while saving a new one).
    property <string> editing: "";
    // The channel waiting on "delete?" ("" when no dialog is up).
    property <string> deleting: "";
    property <string> deleting-name;
    property <length> scroll-origin;
    in property <[string]> apps;
    in-out property <string> channel;
    in property <bool> focus-text: false;
    callback menu;
    callback press(string);
    callback launch(string);
    callback send-text(string);
    // The on-screen keyboard, in window coordinates (from the Window's virtual-keyboard-* properties).
    in property <length> kb-top;
    in property <length> kb-height;
    // While typing, the "type to TV" row rides just above the keyboard.
    property <bool> lifted: text.has-focus && root.kb-height > 0;
    property <length> bar-y: root.lifted ? min(slot.y, root.kb-top - root.absolute-position.y - 72px - 10px) : slot.y;

    VerticalLayout {
    spacing: Theme.gap;
    Header { title: root.tv-name; tappable: true; title-clicked => { root.devices(); } menu => { root.menu(); } }
    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        Text {
            text: root.editing != "" ? @tr("Rename {}", root.editing)
                : root.naming ? @tr("Name for {}", root.channel)
                : @tr("Channel");
            color: Theme.muted;
            font-size: 19px;
        }
        Text { text: root.channel == "" ? "_" : root.channel; color: Theme.fg; font-size: 64px; horizontal-alignment: right; overflow: elide; }
    }
    // Saved channels, one tap away.
    flick := Flickable {
        height: 44px;
        // The chips handle their own drags (tap, long-press, swipe up, scroll), so the row doesn't flick by itself.
        interactive: false;
        content-width: chips.preferred-width;
        chips := HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if root.channel != "" && root.editing == "": Key {
                width: 92px;
                label: root.naming ? @tr("Cancel") : @tr("+ save");
                kind: root.naming ? KeyKind.primary : KeyKind.operator;
                font-size: 14px;
                clicked => { root.naming = !root.naming; if root.naming { text.focus(); } }
            }
            if root.editing != "": Key {
                width: 92px;
                label: @tr("Cancel");
                kind: KeyKind.primary;
                font-size: 14px;
                clicked => { root.stop-naming(); }
            }
            for c in root.channels: ChannelChip {
                label: c.name;
                selected: c.number == root.editing;
                tapped => {
                    root.channel = c.number;
                    root.tune(c.number);
                }
                long-pressed => {
                    root.editing = c.number;
                    root.channel = c.number;
                    root.naming = true;
                    text.text = c.name;
                    text.focus();
                }
                swiped-up => {
                    root.deleting = c.number;
                    root.deleting-name = c.name;
                }
                scroll-start => { root.scroll-origin = flick.content-x; }
                scroll-by(dx) => {
                    flick.content-x = clamp(root.scroll-origin + dx, min(0px, flick.width - flick.content-width), 0px);
                }
            }
            if root.channels.length == 0 && root.channel == "": Text {
                text: @tr("Type a number, then + save");
                color: Theme.muted;
                font-size: 14px;
                vertical-alignment: center;
            }
        }
    }
    Divider { }
    HorizontalLayout {
        spacing: Theme.gap;
        height: 52px;
        Key { label: root.apps[0]; font-size: 15px; clicked => { root.launch(root.apps[0]); } }
        Key { label: root.apps[1]; font-size: 15px; clicked => { root.launch(root.apps[1]); } }
        Key { label: root.apps[2]; font-size: 15px; clicked => { root.launch(root.apps[2]); } }
    }
    HorizontalLayout {
        spacing: Theme.gap;
        height: 52px;
        Key { label: root.apps[3]; font-size: 15px; clicked => { root.launch(root.apps[3]); } }
        Key { label: root.apps[4]; font-size: 15px; clicked => { root.launch(root.apps[4]); } }
        Key { label: root.apps[5]; font-size: 15px; clicked => { root.launch(root.apps[5]); } }
    }
    GridLayout {
        spacing: Theme.gap;
        vertical-stretch: 1;
        Row {
            Key { label: "1"; font-size: 26px; clicked => { root.digit("1"); } }
            Key { label: "2"; font-size: 26px; clicked => { root.digit("2"); } }
            Key { label: "3"; font-size: 26px; clicked => { root.digit("3"); } }
            Key { label: "CH+"; kind: KeyKind.operator; font-size: 16px; clicked => { root.press("ch+"); } }
        }
        Row {
            Key { label: "4"; font-size: 26px; clicked => { root.digit("4"); } }
            Key { label: "5"; font-size: 26px; clicked => { root.digit("5"); } }
            Key { label: "6"; font-size: 26px; clicked => { root.digit("6"); } }
            Key { label: "CH−"; kind: KeyKind.operator; font-size: 16px; clicked => { root.press("ch-"); } }
        }
        Row {
            Key { label: "7"; font-size: 26px; clicked => { root.digit("7"); } }
            Key { label: "8"; font-size: 26px; clicked => { root.digit("8"); } }
            Key { label: "9"; font-size: 26px; clicked => { root.digit("9"); } }
            Key { label: "VOL+"; kind: KeyKind.operator; font-size: 16px; clicked => { root.press("vol+"); } }
        }
        Row {
            Key { label: "—"; font-size: 26px; clicked => { root.digit("dash"); } }
            Key { label: "0"; font-size: 26px; clicked => { root.digit("0"); } }
            Key { has-icon: true; icon: @image-url("icons/bksp.svg"); icon-size: 28px; clicked => { root.channel = ""; } }
            Key { label: "VOL−"; kind: KeyKind.operator; font-size: 16px; clicked => { root.press("vol-"); } }
        }
    }
    slot := Rectangle { height: 72px; }
    }

    // A clean strip of page color behind the lifted row, so the keypad doesn't show through.
    if root.lifted: Rectangle {
        y: root.bar-y - 14px;
        height: root.height - self.y + 40px;
        background: Theme.bg;
        Rectangle { y: 0; height: 1px; background: Theme.divider; }
    }
    HorizontalLayout {
        y: root.bar-y;
        height: 72px;
        animate y { duration: 160ms; easing: ease-out; }
        spacing: Theme.gap;
        Rectangle {
            horizontal-stretch: 3;
            border-radius: Theme.radius;
            background: Theme.key;
            border-width: 1px;
            border-color: Theme.key-border;
            text := TextInput {
                x: 18px;
                width: parent.width - 36px;
                color: Theme.fg;
                font-size: 16px;
                vertical-alignment: center;
                accepted => { root.go(); }
            }
            if text.text == "": Text { x: 18px; width: parent.width - 36px; overflow: elide; text: root.naming ? @tr("BFMTV, France 2…") : @tr("Type to TV…"); color: Theme.muted; font-size: 16px; vertical-alignment: center; }
        }
        Key { horizontal-stretch: 1; label: root.naming ? @tr("SAVE") : @tr("GO"); kind: KeyKind.primary; font-size: root.naming ? 18px : 22px; clicked => { root.go(); } }
    }


    if root.deleting != "": Confirm {
        title: @tr("Delete {}?", root.deleting-name);
        message: @tr("Channel {} won't be saved anymore. You can always save it again.", root.deleting);
        confirmed => {
            root.remove-channel(root.deleting);
            if root.editing == root.deleting { root.stop-naming(); }
            root.deleting = "";
        }
        cancelled => { root.deleting = ""; }
    }

    // Digits go to the TV straight away; the display just echoes them.
    function digit(d: string) {
        root.channel = d == "dash" ? root.channel + "-" : root.channel + d;
        root.press(d);
    }
    function go() {
        if root.naming {
            if text.text != "" {
                root.save-channel(root.editing != "" ? root.editing : root.channel, text.text);
                root.stop-naming();
            }
            return;
        }
        if text.text != "" {
            root.send-text(text.text);
            text.text = "";
        } else {
            root.press("ok");
            root.channel = "";
        }
    }
    function stop-naming() {
        text.text = "";
        root.naming = false;
        root.editing = "";
        text.clear-focus();
    }
    public function focus-keyboard() {
        text.focus();
    }
}
