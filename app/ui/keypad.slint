import { Theme } from "theme.slint";
import { Key, KeyKind, Header, Divider } from "widgets.slint";

export struct ChannelRow {
    number: string,
    name: string,
}

// 03 · Channels, apps & typing.
export component KeypadPage inherits Rectangle {
    in property <string> tv-name;
    // Channels saved by name (4002 → BFMTV): tap one to tune, "+ save" names the number typed.
    in property <[ChannelRow]> channels;
    callback tune(string);
    callback save-channel(string, string);
    callback remove-channel(string);
    callback devices;
    property <bool> naming: false;
    property <bool> editing: false;
    in property <[string]> apps;
    in-out property <string> channel;
    in property <bool> focus-text: false;
    callback menu;
    callback press(string);
    callback launch(string);
    callback send-text(string);
    // The on-screen keyboard, in window coordinates (from the Window's virtual-keyboard-* properties).
    in property <length> kb-top;
    in property <length> kb-height;
    // While typing, the "type to TV" row rides just above the keyboard.
    property <bool> lifted: text.has-focus && root.kb-height > 0;
    property <length> bar-y: root.lifted ? min(slot.y, root.kb-top - root.absolute-position.y - 72px - 10px) : slot.y;

    VerticalLayout {
    spacing: Theme.gap;
    Header { title: root.tv-name; tappable: true; title-clicked => { root.devices(); } menu => { root.menu(); } }
    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        Text { text: root.naming ? "name for " + root.channel : "channel"; color: Theme.muted; font-size: 19px; }
        Text { text: root.channel == "" ? "_" : root.channel; color: Theme.fg; font-size: 64px; horizontal-alignment: right; overflow: elide; }
    }
    // Saved channels, one tap away.
    Flickable {
        height: 44px;
        content-width: chips.preferred-width;
        chips := HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if root.channel != "" && !root.editing: Key {
                width: 92px;
                label: root.naming ? "cancel" : "+ save";
                kind: root.naming ? KeyKind.primary : KeyKind.operator;
                font-size: 14px;
                clicked => { root.naming = !root.naming; if root.naming { text.focus(); } }
            }
            for c in root.channels: Key {
                width: max(84px, label-width.preferred-width + 28px);
                label: root.editing ? "x " + c.name : c.name;
                font-size: 14px;
                label-width := Text { visible: false; text: (root.editing ? "x " : "") + c.name; font-size: 14px; }
                clicked => {
                    if root.editing {
                        root.remove-channel(c.number);
                    } else {
                        root.channel = c.number;
                        root.tune(c.number);
                    }
                }
            }
            if root.channels.length > 0 && !root.naming: Key {
                width: 72px;
                label: root.editing ? "done" : "edit";
                kind: root.editing ? KeyKind.primary : KeyKind.operator;
                font-size: 14px;
                clicked => { root.editing = !root.editing; }
            }
            if root.channels.length == 0 && root.channel == "": Text {
                text: "type a number, then + save";
                color: Theme.muted;
                font-size: 14px;
                vertical-alignment: center;
            }
        }
    }
    Divider { }
    HorizontalLayout {
        spacing: Theme.gap;
        height: 52px;
        Key { label: root.apps[0]; font-size: 15px; clicked => { root.launch(root.apps[0]); } }
        Key { label: root.apps[1]; font-size: 15px; clicked => { root.launch(root.apps[1]); } }
        Key { label: root.apps[2]; font-size: 15px; clicked => { root.launch(root.apps[2]); } }
    }
    HorizontalLayout {
        spacing: Theme.gap;
        height: 52px;
        Key { label: root.apps[3]; font-size: 15px; clicked => { root.launch(root.apps[3]); } }
        Key { label: root.apps[4]; font-size: 15px; clicked => { root.launch(root.apps[4]); } }
        Key { label: root.apps[5]; font-size: 15px; clicked => { root.launch(root.apps[5]); } }
    }
    GridLayout {
        spacing: Theme.gap;
        vertical-stretch: 1;
        Row {
            Key { label: "1"; font-size: 26px; clicked => { root.digit("1"); } }
            Key { label: "2"; font-size: 26px; clicked => { root.digit("2"); } }
            Key { label: "3"; font-size: 26px; clicked => { root.digit("3"); } }
            Key { label: "CH+"; kind: KeyKind.operator; font-size: 16px; clicked => { root.press("ch+"); } }
        }
        Row {
            Key { label: "4"; font-size: 26px; clicked => { root.digit("4"); } }
            Key { label: "5"; font-size: 26px; clicked => { root.digit("5"); } }
            Key { label: "6"; font-size: 26px; clicked => { root.digit("6"); } }
            Key { label: "CH−"; kind: KeyKind.operator; font-size: 16px; clicked => { root.press("ch-"); } }
        }
        Row {
            Key { label: "7"; font-size: 26px; clicked => { root.digit("7"); } }
            Key { label: "8"; font-size: 26px; clicked => { root.digit("8"); } }
            Key { label: "9"; font-size: 26px; clicked => { root.digit("9"); } }
            Key { label: "VOL+"; kind: KeyKind.operator; font-size: 16px; clicked => { root.press("vol+"); } }
        }
        Row {
            Key { label: "—"; font-size: 26px; clicked => { root.digit("dash"); } }
            Key { label: "0"; font-size: 26px; clicked => { root.digit("0"); } }
            Key { has-icon: true; icon: @image-url("icons/bksp.svg"); icon-size: 28px; clicked => { root.channel = ""; } }
            Key { label: "VOL−"; kind: KeyKind.operator; font-size: 16px; clicked => { root.press("vol-"); } }
        }
    }
    slot := Rectangle { height: 72px; }
    }

    // A clean strip of page color behind the lifted row, so the keypad doesn't show through.
    if root.lifted: Rectangle {
        y: root.bar-y - 14px;
        height: root.height - self.y + 40px;
        background: Theme.bg;
        Rectangle { y: 0; height: 1px; background: Theme.divider; }
    }
    HorizontalLayout {
        y: root.bar-y;
        height: 72px;
        animate y { duration: 160ms; easing: ease-out; }
        spacing: Theme.gap;
        Rectangle {
            horizontal-stretch: 3;
            border-radius: Theme.radius;
            background: Theme.key;
            border-width: 1px;
            border-color: Theme.key-border;
            text := TextInput {
                x: 18px;
                width: parent.width - 36px;
                color: Theme.fg;
                font-size: 16px;
                vertical-alignment: center;
                accepted => { root.go(); }
            }
            if text.text == "": Text { x: 18px; text: root.naming ? "BFMTV, France 2…" : "type to TV…"; color: Theme.muted; font-size: 16px; }
        }
        Key { horizontal-stretch: 1; label: root.naming ? "SAVE" : "GO"; kind: KeyKind.primary; font-size: root.naming ? 18px : 22px; clicked => { root.go(); } }
    }


    // Digits go to the TV straight away; the display just echoes them.
    function digit(d: string) {
        root.channel = d == "dash" ? root.channel + "-" : root.channel + d;
        root.press(d);
    }
    function go() {
        if root.naming {
            if text.text != "" {
                root.save-channel(root.channel, text.text);
                text.text = "";
                root.naming = false;
            }
            return;
        }
        if text.text != "" {
            root.send-text(text.text);
            text.text = "";
        } else {
            root.press("ok");
            root.channel = "";
        }
    }
    public function focus-keyboard() {
        text.focus();
    }
}
