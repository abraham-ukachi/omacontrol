import { Theme } from "theme.slint";
import { Key, KeyKind, Header, Divider } from "widgets.slint";
import { AsciiScan } from "scanner.slint";

export struct DeviceRow {
    name: string,
    meta: string,
    ip: string,
    current: bool,
    ac: bool,
}

// 01 · Devices: the TVs and air conditioners we know about.
export component DevicesPage inherits VerticalLayout {
    in property <[DeviceRow]> devices;
    in property <bool> scanning;
    in property <string> subnet;
    callback menu;
    callback pick(int);
    callback rescan;
    callback add-ip(string);
    callback add-ir(string);
    callback add-ac();
    in property <bool> has-ir;

    property <bool> adding: false;

    spacing: Theme.gap;
    Header { title: @tr("Devices"); menu => { root.menu(); } }
    if !root.scanning: VerticalLayout {
        padding: 8px;
        padding-top: 22px;
        spacing: 8px;
        Text { text: root.subnet == "your network" ? @tr("Your network") : root.subnet; color: Theme.muted; font-size: 19px; }
        Text { text: @tr("{} found", root.devices.length); color: Theme.fg; font-size: 64px; horizontal-alignment: right; }
    }
    // While scanning: the ASCII radar on the left, the running count on the right.
    if root.scanning: HorizontalLayout {
        padding: 8px;
        padding-top: 14px;
        spacing: 12px;
        AsciiScan { label: @tr("Scanning {}", root.subnet); size: 15px; }
        Text {
            text: root.devices.length == 0 ? "" : root.devices.length + "";
            color: Theme.fg; font-size: 64px; horizontal-alignment: right; vertical-alignment: center;
        }
    }
    Divider { }
    Flickable {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start;
            spacing: Theme.gap;
            for d[i] in root.devices: Rectangle {
                height: 72px;
                border-radius: Theme.radius;
                background: d.current ? Theme.operator : (row.pressed ? Theme.key-pressed : Theme.key);
                border-width: d.current ? 0px : 1px;
                border-color: Theme.key-border;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 18px;
                    spacing: 14px;
                    VerticalLayout { alignment: center; Image { source: d.ac ? @image-url("icons/ac.svg") : @image-url("icons/tv.svg"); colorize: Theme.fg; width: 28px; height: 28px; } }
                    VerticalLayout {
                        alignment: center;
                        spacing: 5px;
                        Text { text: d.name; color: Theme.fg; font-size: 17px; overflow: elide; }
                        Text {
                            text: d.meta == "IR · tap to set up" ? @tr("IR · tap to set up")
                                : d.meta == "code · IR" ? @tr("Code · IR")
                                : d.meta;
                            color: Theme.muted;
                            font-size: 13px;
                            overflow: elide;
                        }
                    }
                    if d.current: VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; } }
                    if !d.current: Text { text: d.ip; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                }
                row := TouchArea { clicked => { root.pick(i); } }
            }
        }
    }
    // With an IR blaster, air conditioners and Samsung, LG or Sony TVs work, even without Wi-Fi.
    if root.adding && root.has-ir: Key {
        height: 52px;
        label: @tr("Air conditioner · IR");
        kind: KeyKind.operator;
        font-size: 15px;
        clicked => { root.add-ac(); root.adding = false; }
    }
    if root.adding && root.has-ir: HorizontalLayout {
        height: 52px;
        spacing: Theme.gap;
        for b in ["Samsung", "LG", "Sony"]: Key {
            label: @tr("IR · {}", b);
            kind: KeyKind.operator;
            font-size: 15px;
            clicked => { root.add-ir(b); root.adding = false; }
        }
    }
    if root.adding: Rectangle {
        height: 64px;
        border-radius: Theme.radius;
        background: Theme.key;
        border-width: 1px;
        border-color: Theme.key-border;
        ip := TextInput {
            x: 18px;
            width: parent.width - 36px;
            color: Theme.fg;
            font-size: 18px;
            vertical-alignment: center;
                        accepted => { root.add-ip(self.text); root.adding = false; }
        }
        if ip.text == "": Text { x: 18px; text: "192.168.1.…"; color: Theme.muted; font-size: 18px; }
    }
    HorizontalLayout {
        height: 64px;
        spacing: Theme.gap;
        Key { label: root.adding ? @tr("Cancel") : @tr("Add"); font-size: 17px; clicked => { root.adding = !root.adding; } }
        Key { label: @tr("Rescan"); kind: KeyKind.primary; font-size: 17px; clicked => { root.rescan(); } }
    }
}
