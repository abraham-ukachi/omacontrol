import { Theme } from "theme.slint";
import { Header, Divider } from "widgets.slint";

// The menu: where to go. The theme, About and Feedback live in Settings.
export component MenuPage inherits VerticalLayout {
    in property <string> version;
    callback close;
    callback goto(int);

    spacing: Theme.gap;
    Header { title: "OmaControl"; subtitle: "v" + root.version; menu => { root.close(); } }
    Divider { }
    for item[i] in [@tr("Devices"), @tr("Remote"), @tr("Channels & apps"), @tr("Settings")]: Rectangle {
        height: 52px;
        Text { x: 8px; text: item; color: Theme.fg; font-size: 19px; }
        TouchArea { clicked => { root.goto(i == 3 ? 6 : i); } }
    }
    Rectangle { vertical-stretch: 1; }
}
