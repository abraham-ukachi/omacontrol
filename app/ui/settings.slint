import { Theme, Feedback } from "theme.slint";
import { Key, KeyKind, Header, Divider } from "widgets.slint";

// A text field the Omacalc way: a number key's surface, muted placeholder, ink text.
component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    in property <bool> multiline: false;
    in property <InputType> input-type: InputType.text;
    height: root.multiline ? 150px : 56px;
    border-radius: Theme.radius;
    background: Theme.key;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.key-border;
    input := TextInput {
        x: 16px;
        y: root.multiline ? 14px : 0px;
        width: parent.width - 32px;
        height: root.multiline ? parent.height - 28px : parent.height;
        color: Theme.fg;
        font-size: 16px;
        single-line: !root.multiline;
        wrap: root.multiline ? TextWrap.word-wrap : TextWrap.no-wrap;
        vertical-alignment: root.multiline ? TextVerticalAlignment.top : TextVerticalAlignment.center;
        input-type: root.input-type;
    }
    if input.text == "": Text {
        x: 16px;
        y: root.multiline ? 14px : 0px;
        height: root.multiline ? 22px : parent.height;
        text: root.placeholder;
        color: Theme.muted;
        font-size: 16px;
        vertical-alignment: root.multiline ? TextVerticalAlignment.top : TextVerticalAlignment.center;
    }
}

// One About line: what it is on the left, the value on the right; tap opens it.
component Link inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback clicked;
    height: 50px;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.key-pressed : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text { text: root.label; color: Theme.muted; font-size: 15px; vertical-alignment: center; }
        Text { text: root.value; color: Theme.fg; font-size: 15px; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}


// One Settings row, laid out like a device on Home: the setting, then its current value.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback clicked;
    height: 72px;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.key-pressed : Theme.key;
    border-width: 1px;
    border-color: Theme.key-border;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 14px;
        Text { text: root.label; color: Theme.fg; font-size: 18px; vertical-alignment: center; }
        Text { horizontal-stretch: 1; text: root.value; color: Theme.muted; font-size: 15px; vertical-alignment: center; horizontal-alignment: right; overflow: elide; }
    }
    touch := TouchArea {
        pointer-event(e) => { if e.kind == PointerEventKind.down { Feedback.tap(); } }
        clicked => { root.clicked(); }
    }
}

// One choice in a picker drawer; the current one carries the accent dot.
component Choice inherits Rectangle {
    in property <string> label;
    in property <bool> current;
    callback clicked;
    height: 52px;
    border-radius: Theme.radius;
    background: root.current ? Theme.operator : (touch.pressed ? Theme.key-pressed : transparent);
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        Text { text: root.label; color: Theme.fg; font-size: 16px; vertical-alignment: center; overflow: elide; }
        if root.current: VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; } }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// 07 · Settings: a list like Home (Theme, Language, Feedback, About); Theme and Language open
// a picker drawer from the bottom.
export component SettingsPage inherits Rectangle {
    in property <[string]> themes;
    in property <[string]> languages;
    in-out property <string> language: "system";
    in property <string> version;
    // 0 = the list, 1 = About, 2 = Feedback.
    in-out property <int> tab: 0;
    // The bottom drawer: "", "theme" or "language".
    property <string> picker;
    callback menu;
    callback pick-theme(string);
    callback pick-language(string);
    callback open-url(string);

    // Feedback form (two-way, so the app can clear it once it's sent).
    in-out property <string> fb-kind: "Feedback";
    in-out property <string> fb-email;
    in-out property <string> fb-title;
    in-out property <string> fb-message;
    in property <string> fb-status-code;
    in property <string> fb-status-detail;
    in property <bool> fb-sending;
    callback send-feedback();
    // The on-screen keyboard's height, so the form can scroll above it.
    in property <length> kb-height;

    function localized-feedback-status() -> string {
        if root.fb-status-code == "email-invalid" { return @tr("That email address doesn't look right"); }
        if root.fb-status-code == "title-required" { return @tr("Add a title"); }
        if root.fb-status-code == "message-short" { return @tr("Write a few more words"); }
        if root.fb-status-code == "sending" { return @tr("Sending…"); }
        if root.fb-status-code == "sent" { return @tr("Sent. Thank you!"); }
        if root.fb-status-code == "failed" { return @tr("Not sent: {}", root.fb-status-detail); }
        return "";
    }

    function language-name(code: string) -> string {
        if code == "system" { return @tr("System default"); }
        if code == "en" { return "English"; }
        if code == "de" { return "Deutsch"; }
        if code == "es" { return "Español"; }
        if code == "fr" { return "Français"; }
        if code == "hi" { return "हिन्दी"; }
        if code == "it" { return "Italiano"; }
        if code == "ja" { return "日本語"; }
        if code == "pt" { return "Português"; }
        if code == "ru" { return "Русский"; }
        if code == "tr" { return "Türkçe"; }
        return "简体中文";
    }


    VerticalLayout {
        spacing: Theme.gap;
        Header {
            title: root.tab == 0 ? @tr("Settings") : root.tab == 1 ? @tr("About") : @tr("Feedback");
            subtitle: root.tab == 0 ? "v" + root.version : @tr("Settings");
            tappable: root.tab != 0;
            title-clicked => { root.tab = 0; }
            menu => { root.menu(); }
        }
        Divider { }

        if root.tab == 0: Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                spacing: Theme.gap;
                SettingRow { label: @tr("Theme"); value: Theme.name; clicked => { root.picker = "theme"; } }
                SettingRow { label: @tr("Language"); value: root.language-name(root.language); clicked => { root.picker = "language"; } }
                SettingRow { label: @tr("Feedback"); value: "›"; clicked => { root.tab = 2; } }
                SettingRow { label: @tr("About"); value: "v" + root.version; clicked => { root.tab = 1; } }
            }
        }
        if root.tab == 1: Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                spacing: 4px;
                padding-top: 10px;
                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    Text { text: @tr("About"); color: Theme.muted; font-size: 19px; }
                    Text { text: "OmaControl"; color: Theme.fg; font-size: 40px; horizontal-alignment: right; }
                    Text { text: "v" + root.version; color: Theme.muted; font-size: 16px; horizontal-alignment: right; }
                }
                Rectangle { height: 14px; }
                Text { x: 8px; text: @tr("A dead-simple remote for TVs and air conditioners, in Omarchy's colors."); color: Theme.fg; font-size: 15px; wrap: word-wrap; }
                Rectangle { height: 10px; }
                Divider { }
                Link { label: @tr("Made by"); value: "Abraham Ukachi"; clicked => { root.open-url("https://github.com/abraham-ukachi"); } }
                Link { label: "GitHub"; value: "@abraham-ukachi"; clicked => { root.open-url("https://github.com/abraham-ukachi"); } }
                Link { label: "X"; value: "@abrahamukachi"; clicked => { root.open-url("https://x.com/abrahamukachi"); } }
                Link { label: @tr("Email"); value: "abrahamukachi@gmail.com"; clicked => { root.open-url("mailto:abrahamukachi@gmail.com?subject=OmaControl"); } }
                Divider { }
                Link { label: @tr("Source"); value: "github.com/abraham-ukachi/omacontrol"; clicked => { root.open-url("https://github.com/abraham-ukachi/omacontrol"); } }
                Link { label: @tr("License"); value: "MIT"; clicked => { root.open-url("https://github.com/abraham-ukachi/omacontrol/blob/main/LICENSE"); } }
                Link { label: @tr("Version"); value: root.version; clicked => { root.open-url("https://github.com/abraham-ukachi/omacontrol/releases"); } }
                Rectangle { height: 16px; }
                Text { x: 8px; text: @tr("MOTTO: We'll always do more"); color: Theme.muted; font-size: 13px; }
            }
        }

        if root.tab == 2: Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                spacing: Theme.gap;
                padding-top: 6px;
                padding-bottom: root.kb-height;
                Text { x: 8px; text: @tr("An idea, or something broken? It goes straight to Abraham's inbox."); color: Theme.muted; font-size: 14px; wrap: word-wrap; }
                HorizontalLayout {
                    height: 48px;
                    spacing: Theme.gap;
                    for k in ["Feedback", "Issue"]: Key {
                        label: k == "Feedback" ? @tr("Feedback") : @tr("Issue");
                        font-size: 15px;
                        kind: root.fb-kind == k ? KeyKind.primary : KeyKind.operator;
                        clicked => { root.fb-kind = k; }
                    }
                }
                Field { placeholder: @tr("Your email (optional, for a reply)"); text <=> root.fb-email; input-type: InputType.text; }
                Field { placeholder: root.fb-kind == "Issue" ? @tr("What broke?") : @tr("Title"); text <=> root.fb-title; }
                Field { placeholder: root.fb-kind == "Issue" ? @tr("What happened, and on which TV or AC?") : @tr("Tell me more…"); text <=> root.fb-message; multiline: true; }
                HorizontalLayout {
                    height: 60px;
                    spacing: Theme.gap;
                    Text { horizontal-stretch: 2; text: root.localized-feedback-status(); color: Theme.muted; font-size: 14px; vertical-alignment: center; wrap: word-wrap; }
                    Key {
                        horizontal-stretch: 1;
                        label: root.fb-sending ? "…" : @tr("Send");
                        kind: KeyKind.primary;
                        font-size: 18px;
                        clicked => { if !root.fb-sending { root.send-feedback(); } }
                    }
                }
            }
        }
    }

    // The picker drawer slides up from the bottom; the current choice stays pinned on top.
    Rectangle {
        visible: root.picker != "";
        background: Theme.bg.with-alpha(root.picker != "" ? 0.82 : 0);
        animate background { duration: 180ms; }
        TouchArea { clicked => { root.picker = ""; } }
        sheet := Rectangle {
            x: (parent.width - self.width) / 2;
            y: root.picker == "" ? parent.height : parent.height - self.height;
            width: min(parent.width, 460px);
            height: parent.height * 0.72;
            border-radius: Theme.radius;
            background: Theme.bg;
            border-width: 1px;
            border-color: Theme.divider;
            animate y { duration: 220ms; easing: ease-out; }
            TouchArea { }
            sheet-body := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: root.picker == "theme" ? @tr("Theme") : @tr("Language"); color: Theme.muted; font-size: 19px; }
                Choice {
                    label: root.picker == "theme" ? Theme.name : root.language-name(root.language);
                    current: true;
                    clicked => { root.picker = ""; }
                }
                Divider { }
                Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        spacing: 2px;
                        if root.picker == "theme": VerticalLayout {
                            for t in root.themes: Choice {
                                visible: t != Theme.name;
                                height: t != Theme.name ? 52px : 0px;
                                label: t;
                                clicked => { root.pick-theme(t); root.picker = ""; }
                            }
                        }
                        if root.picker == "language": VerticalLayout {
                            for l in root.languages: Choice {
                                visible: l != root.language;
                                height: l != root.language ? 52px : 0px;
                                label: root.language-name(l);
                                clicked => { root.language = l; root.pick-language(l); root.picker = ""; }
                            }
                        }
                    }
                }
            }
        }
    }
}
