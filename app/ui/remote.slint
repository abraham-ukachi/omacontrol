import { Theme } from "theme.slint";
import { Key, KeyKind, Rocker, Header, Divider } from "widgets.slint";

// 02 · Remote.
export component RemotePage inherits VerticalLayout {
    in property <string> tv-name;
    in property <string> tv-status;
    in property <bool> online;
    callback menu;
    callback press(string);
    callback keypad;
    callback keyboard;
    callback devices;
    // Android TV pairing: the TV shows a 6-character code, typed here.
    in property <bool> pairing;
    callback pair(string);
    callback cancel-pair;
    in property <length> kb-height;

    spacing: Theme.gap;
    Header { title: root.tv-name; subtitle: root.tv-status; online: root.online; tappable: true; title-clicked => { root.devices(); } menu => { root.menu(); } }
    Divider { }
    if root.pairing: VerticalLayout {
        spacing: Theme.gap;
        padding-top: 18px;
        padding-bottom: root.kb-height;
        vertical-stretch: 1;
        alignment: start;
        Text { x: 8px; text: "pair"; color: Theme.muted; font-size: 19px; }
        Text { text: "Type the code your TV shows"; color: Theme.fg; font-size: 22px; wrap: word-wrap; horizontal-alignment: right; }
        Rectangle { height: 8px; }
        Rectangle {
            height: 84px;
            border-radius: Theme.radius;
            background: Theme.key;
            border-width: 1px;
            border-color: code.has-focus ? Theme.accent : Theme.key-border;
            code := TextInput {
                x: 18px;
                width: parent.width - 36px;
                color: Theme.fg;
                font-size: 40px;
                horizontal-alignment: center;
                vertical-alignment: center;
                accepted => { root.pair(self.text); }
            }
            if code.text == "": Text { text: "_ _ _ _ _ _"; color: Theme.muted; font-size: 32px; }
        }
        Text { x: 8px; text: "6 characters, 0-9 and A-F. It stays on the TV for a minute."; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
        HorizontalLayout {
            height: 64px;
            spacing: Theme.gap;
            Key { label: "Cancel"; font-size: 17px; clicked => { root.cancel-pair(); } }
            Key { label: "Pair"; kind: KeyKind.primary; font-size: 17px; clicked => { root.pair(code.text); } }
        }
        init => { code.focus(); }
    }
    if !root.pairing: VerticalLayout {
    spacing: Theme.gap;
    vertical-stretch: 1;
    HorizontalLayout {
        height: 58px;
        spacing: Theme.gap;
        Key { has-icon: true; icon: @image-url("icons/power.svg"); clicked => { root.press("power"); } }
        Key { has-icon: true; icon: @image-url("icons/input.svg"); clicked => { root.press("input"); } }
        Key { has-icon: true; icon: @image-url("icons/mute.svg"); clicked => { root.press("mute"); } }
        Key { has-icon: true; icon: @image-url("icons/grid.svg"); kind: KeyKind.operator; clicked => { root.keypad(); } }
    }
    GridLayout {
        spacing: Theme.gap;
        padding-top: 10px;
        min-height: 260px;
        vertical-stretch: 1;
        Row {
            Rectangle { }
            Key { has-icon: true; icon: @image-url("icons/up.svg"); icon-size: 30px; clicked => { root.press("up"); } }
            Rectangle { }
        }
        Row {
            Key { has-icon: true; icon: @image-url("icons/left.svg"); icon-size: 30px; clicked => { root.press("left"); } }
            Key { label: "OK"; kind: KeyKind.primary; font-size: 22px; clicked => { root.press("ok"); } }
            Key { has-icon: true; icon: @image-url("icons/right.svg"); icon-size: 30px; clicked => { root.press("right"); } }
        }
        Row {
            Rectangle { }
            Key { has-icon: true; icon: @image-url("icons/down.svg"); icon-size: 30px; clicked => { root.press("down"); } }
            Rectangle { }
        }
    }
    HorizontalLayout {
        height: 58px;
        spacing: Theme.gap;
        padding-top: 0px;
        Key { has-icon: true; icon: @image-url("icons/back.svg"); clicked => { root.press("back"); } }
        Key { has-icon: true; icon: @image-url("icons/home.svg"); clicked => { root.press("home"); } }
        Key { has-icon: true; icon: @image-url("icons/menu.svg"); clicked => { root.press("menu"); } }
    }
    HorizontalLayout {
        spacing: Theme.gap;
        min-height: 220px;
        vertical-stretch: 1;
        Rocker { horizontal-stretch: 1.4; label: "VOL"; up => { root.press("vol+"); } down => { root.press("vol-"); } }
        GridLayout {
            horizontal-stretch: 3;
            spacing: Theme.gap;
            Row {
                Key { has-icon: true; icon-size: 22px; icon: @image-url("icons/rew.svg"); clicked => { root.press("rew"); } }
                Key { has-icon: true; icon-size: 22px; icon: @image-url("icons/play.svg"); clicked => { root.press("play"); } }
                Key { has-icon: true; icon-size: 22px; icon: @image-url("icons/ff.svg"); clicked => { root.press("ff"); } }
            }
            Row {
                Key { has-icon: true; icon-size: 22px; icon: @image-url("icons/kbd.svg"); clicked => { root.keyboard(); } }
                Key { has-icon: true; icon-size: 22px; icon: @image-url("icons/home.svg"); clicked => { root.press("home"); } }
                Key { label: "123"; clicked => { root.keypad(); } }
            }
        }
        Rocker { horizontal-stretch: 1.4; label: "CH"; up => { root.press("ch+"); } down => { root.press("ch-"); } }
    }
    }
}
