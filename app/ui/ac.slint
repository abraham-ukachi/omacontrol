import { Theme } from "theme.slint";
import { Key, KeyKind, Header, Divider, Confirm } from "widgets.slint";

// Which keys of a per-key NEC remote have their code yet.
export struct AcLearned {
    mode: bool,
    fan: bool,
    cooler: bool,
    warmer: bool,
    timer: bool,
    sleep: bool,
    swing: bool,
}

// A key that may still need learning: a small "?" in the corner until it has its code.
component LearnKey inherits Key {
    in property <bool> unlearned;
    Text {
        x: parent.width - 24px;
        y: 8px;
        text: "?";
        color: Theme.muted;
        font-size: 14px;
        visible: root.unlearned;
    }
}

// A toggle key (swing, sleep): an accent dot in the corner while it's on.
component Toggle inherits LearnKey {
    in property <bool> on;
    kind: KeyKind.operator;
    Rectangle {
        x: parent.width - 20px;
        y: 12px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.accent;
        visible: root.on;
    }
}

// The NEC sweep: a progress card while codes go out, then a review to replay and keep one.
// `learning` names the AC key being learned; empty while finding the power code.
export component NecScanOverlay inherits Rectangle {
    in property <bool> scan-active;
    in property <bool> scan-finished;
    in property <bool> scan-cancelled;
    in property <int> scan-count;
    in property <int> scan-total;
    in property <int> scan-index;
    in property <bool> scan-review;
    in property <string> scan-code;
    in property <string> scan-result;
    in property <string> learning;
    property <float> scan-progress: root.scan-total > 0 ? (root.scan-count * 1.0) / root.scan-total : 0;
    callback setup(string);
    callback scan-cancel();
    callback scan-navigate(int);
        background: Theme.bg.with-alpha(0.82);
        TouchArea { }
        card := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 32px, 420px);
            height: body.preferred-height;
            border-radius: Theme.radius;
            background: Theme.bg;
            border-width: 1px;
            border-color: Theme.divider;
            TouchArea { }
            body := VerticalLayout {
                padding: 20px;
                spacing: 14px;
                Text {
                    text: root.learning == "magic" ? @tr("Find the magic key")
                        : root.learning != "" ? @tr("Find the {} key", root.learning)
                        : root.scan-review ? @tr("Review NEC codes")
                        : root.scan-active ? @tr("Scanning NEC codes")
                        : root.scan-cancelled ? @tr("NEC scan stopped")
                        : root.scan-result != "" ? @tr("NEC scan failed")
                        : @tr("NEC scan complete");
                    color: Theme.fg;
                    font-size: 22px;
                    wrap: word-wrap;
                }
                if root.scan-active && !root.scan-review: Text {
                    text: root.scan-count + " / " + root.scan-total;
                    color: Theme.muted;
                    font-size: 16px;
                }
                if root.scan-review: Text {
                    text: @tr("Candidate {} of {}", root.scan-index + 1, root.scan-total);
                    color: Theme.muted;
                    font-size: 15px;
                }
                if !root.scan-review: Rectangle {
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.operator;
                    Rectangle { width: parent.width * root.scan-progress; height: parent.height; border-radius: 4px; background: Theme.accent; }
                }
                if root.scan-code != "": Text { text: root.scan-code; color: Theme.fg; font-size: 14px; }
                Text {
                    text: root.scan-result != "" ? @tr("Error: {}", root.scan-result)
                        : root.scan-review
                            ? @tr("Use Previous or Next to replay a code, then choose Use this to save it.")
                        : root.scan-active
                            ? root.learning == "magic"
                                ? @tr("Watch the TV and tap Found it as soon as it does what you want this key to do.")
                            : root.learning != ""
                                ? @tr("Watch the AC and tap Found it as soon as it reacts to this key.")
                                : @tr("Your phone cannot detect an IR response. Watch the AC and tap Found it when it reacts.")
                            : root.scan-cancelled
                                ? @tr("Scan stopped. You can start again when ready.")
                                : @tr("Your phone cannot detect an IR response. If the AC did not react, try another angle or start again.");
                    color: Theme.muted;
                    font-size: 15px;
                    wrap: word-wrap;
                }
                if root.scan-review: HorizontalLayout {
                    height: 56px;
                    spacing: Theme.gap;
                    Key { label: @tr("Previous"); kind: KeyKind.operator; font-size: 15px; clicked => { root.scan-navigate(-1); } }
                    Key { label: @tr("Next"); kind: KeyKind.operator; font-size: 15px; clicked => { root.scan-navigate(1); } }
                }
                if root.scan-review: HorizontalLayout {
                    height: 56px;
                    spacing: Theme.gap;
                    Key { label: @tr("Done"); kind: KeyKind.operator; font-size: 15px; clicked => { root.setup("scan-dismiss"); } }
                    Key { label: @tr("Use this"); kind: KeyKind.primary; font-size: 15px; clicked => { root.setup("scan-save"); } }
                }
                if !root.scan-review: HorizontalLayout {
                    height: 56px;
                    spacing: Theme.gap;
                    if root.scan-count > 0 && (root.scan-active || root.scan-finished): Key {
                        label: root.scan-active ? @tr("Found it") : @tr("Review codes");
                        kind: KeyKind.primary;
                        font-size: 16px;
                        clicked => { root.setup("scan-found"); }
                    }
                    Key {
                        label: root.scan-active ? @tr("Cancel scan") : @tr("Done");
                        kind: KeyKind.operator;
                        font-size: 16px;
                        clicked => {
                            if root.scan-active { root.scan-cancel(); } else { root.setup("scan-dismiss"); }
                        }
                    }
                }
            }
        }
    }

global AcFormat {
    // "2:30": minutes as hours and minutes.
    public pure function clock(m: int) -> string {
        return floor(m / 60) + ":" + (m - floor(m / 60) * 60 < 10 ? "0" : "") + (m - floor(m / 60) * 60);
    }
}

// The AC's timer: one at a time, like on its own remote. While the AC runs it switches it off,
// while it's off it switches it on; the AC counts it down itself.
component TimerSheet inherits Rectangle {
    in property <bool> supported;
    in property <int> step: 30;
    in property <int> longest: 1440;
    in property <int> left;
    in property <bool> timer-on;
    in property <bool> power;
    callback set(int);
    callback close();
    property <int> minutes: 60;

    init => {
        root.minutes = root.left > 0 ? clamp(round(root.left / root.step) * root.step, root.step, root.longest) : clamp(60, root.step, root.longest);
    }

    background: Theme.bg.with-alpha(0.82);
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width - 32px, 420px);
        height: body.preferred-height;
        border-radius: Theme.radius;
        background: Theme.bg;
        border-width: 1px;
        border-color: Theme.divider;
        TouchArea { }
        body := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            Text {
                text: (root.left > 0 ? root.timer-on : !root.power) ? @tr("On timer") : @tr("Off timer");
                color: Theme.fg;
                font-size: 22px;
            }
            if !root.supported: Text {
                text: @tr("This AC's protocol has no timer OmaControl can set. Long-press the timer key to import the timer code from its remote.");
                color: Theme.muted;
                font-size: 15px;
                wrap: word-wrap;
            }
            if root.supported: Text {
                text: root.left > 0
                    ? (root.timer-on ? @tr("On in {}", AcFormat.clock(root.left)) : @tr("Off in {}", AcFormat.clock(root.left)))
                    : (root.power ? @tr("Switch the AC off in") : @tr("Switch the AC on in"));
                color: root.left > 0 ? Theme.accent : Theme.muted;
                font-size: 15px;
            }
            if root.supported: HorizontalLayout {
                height: 72px;
                spacing: Theme.gap;
                Key { label: "−"; kind: KeyKind.operator; font-size: 32px; clicked => { root.minutes = max(root.step, root.minutes - root.step); } }
                Text {
                    horizontal-stretch: 2;
                    text: AcFormat.clock(root.minutes);
                    color: Theme.fg;
                    font-size: 40px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Key { label: "+"; kind: KeyKind.operator; font-size: 32px; clicked => { root.minutes = min(root.longest, root.minutes + root.step); } }
            }
            HorizontalLayout {
                height: 56px;
                spacing: Theme.gap;
                if !root.supported: Key { label: @tr("Done"); kind: KeyKind.primary; font-size: 16px; clicked => { root.close(); } }
                if root.supported && root.left > 0: Key { label: @tr("Clear"); kind: KeyKind.operator; font-size: 16px; clicked => { root.set(0); root.close(); } }
                if root.supported && root.left == 0: Key { label: @tr("Cancel"); kind: KeyKind.operator; font-size: 16px; clicked => { root.close(); } }
                if root.supported: Key { label: @tr("Set"); kind: KeyKind.primary; font-size: 16px; clicked => { root.set(root.minutes); root.close(); } }
            }
        }
    }
}

// Import a code for one AC key: Pronto, raw timings, a Flipper Zero .ir file or LIRC codes.
// Named codes in a file land on the keys their names stand for.
component ImportSheet inherits Rectangle {
    in property <string> key-label;
    in property <string> error;
    callback import(string);
    callback close();

    background: Theme.bg.with-alpha(0.82);
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 24px;
        width: min(parent.width - 32px, 420px);
        height: body.preferred-height;
        border-radius: Theme.radius;
        background: Theme.bg;
        border-width: 1px;
        border-color: Theme.divider;
        TouchArea { }
        body := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            Text { text: @tr("Import a code for {}", root.key-label); color: Theme.fg; font-size: 22px; wrap: word-wrap; }
            Rectangle {
                height: 140px;
                border-radius: Theme.radius;
                background: Theme.key;
                border-width: 1px;
                border-color: field.has-focus ? Theme.accent : Theme.key-border;
                clip: true;
                field := TextInput {
                    x: 12px;
                    y: 10px;
                    width: parent.width - 24px;
                    height: parent.height - 20px;
                    color: Theme.fg;
                    font-size: 13px;
                    single-line: false;
                    wrap: word-wrap;
                }
                if field.text == "": Text {
                    x: 12px;
                    y: 10px;
                    width: parent.width - 24px;
                    text: @tr("Paste Pronto hex, raw timings, a Flipper Zero .ir file or LIRC codes");
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
            }
            if root.error != "": Text { text: @tr("Invalid infrared code: {}", root.error); color: Theme.accent; font-size: 14px; wrap: word-wrap; }
            HorizontalLayout {
                height: 56px;
                spacing: Theme.gap;
                Key { label: @tr("Cancel"); kind: KeyKind.operator; font-size: 16px; clicked => { root.close(); } }
                Key { label: @tr("Import"); kind: KeyKind.primary; font-size: 16px; clicked => { root.import(field.text); } }
            }
        }
    }
}

// 04 · Air conditioner, laid out like its own panel: power, mode, fan, − 22° +, sleep, swing.
export component AcPage inherits Rectangle {
    in property <string> name;
    in property <string> status;
    in property <bool> status-error;
    // A pasted Pronto code drives power only; a NEC power code opens the full keypad.
    in property <bool> power-only;
    // Set while the power key is a NEC code: keys without a code learn theirs on first tap.
    in property <bool> nec;
    in property <AcLearned> learned;
    in property <string> learning;
    in property <bool> scan-active;
    in property <bool> scan-finished;
    in property <bool> scan-cancelled;
    in property <int> scan-count;
    in property <int> scan-total;
    in property <int> scan-index;
    in property <bool> scan-review;
    in property <string> scan-code;
    in property <string> scan-result;
    callback setup(string);
    callback scan-cancel();
    callback scan-navigate(int);
    in property <bool> power;
    in property <int> temp;
    in property <string> mode;
    in property <string> fan;
    in property <bool> swing;
    in property <bool> sleep;
    // The timer (protocols that carry one), and importing a code for a key (long-press).
    in property <bool> timer-supported;
    in property <int> timer-step: 30;
    in property <int> timer-max: 1440;
    in property <int> timer-left;
    in property <bool> timer-on;
    callback set-timer(int);
    in-out property <string> import-key;
    in-out property <string> import-error;
    callback import(string, string);
    property <bool> timer-open;
    callback menu;
    callback action(string);
    callback devices;

    function key-label(k: string) -> string {
        return k == "power" ? @tr("power")
            : k == "mode" ? @tr("mode")
            : k == "fan" ? @tr("fan")
            : k == "cooler" ? "−"
            : k == "warmer" ? "+"
            : k == "timer" ? @tr("timer")
            : k == "sleep" ? @tr("sleep")
            : k == "swing" ? @tr("swing")
            : k;
    }

    VerticalLayout {
        spacing: Theme.gap;
        Header {
            title: root.name;
            subtitle: root.status-error ? @tr("Error: {}", root.status) : root.status == "not set up yet" ? @tr("Not set up yet") : root.status == "code · IR" ? @tr("Code · IR") : root.status;
            online: root.power;
            tappable: true;
            title-clicked => { root.devices(); }
            menu => { root.menu(); }
        }
        if root.power-only: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            Text {
                text: @tr("This infrared code controls power only.");
                color: Theme.muted;
                font-size: 19px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Key {
                vertical-stretch: 1;
                min-height: 160px;
                has-icon: true;
                icon: @image-url("icons/power.svg");
                kind: root.power ? KeyKind.primary : KeyKind.number;
                long-press-enabled: true;
                clicked => { root.action("power"); }
                long-pressed => { root.import-key = "power"; }
            }
            Text {
                text: @tr("Long-press a key to import its code.");
                color: Theme.muted;
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        if !root.power-only: VerticalLayout {
            vertical-stretch: 1;
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 14px;
            spacing: 4px;
            Text {
                text: root.power
                    ? @tr("{} · fan {}", root.mode == "cool" ? @tr("Cool") : root.mode == "fan" ? @tr("Fan") : root.mode == "dry" ? @tr("Dry") : root.mode == "heat" ? @tr("Heat") : @tr("Auto"),
                        root.fan == "low" ? @tr("Low") : root.fan == "med" ? @tr("Medium") : root.fan == "high" ? @tr("High") : @tr("Auto"))
                    : @tr("Off");
                color: Theme.muted;
                font-size: 19px;
            }
            if root.timer-left > 0: Text {
                text: root.timer-on ? @tr("On in {}", AcFormat.clock(root.timer-left)) : @tr("Off in {}", AcFormat.clock(root.timer-left));
                color: Theme.accent;
                font-size: 15px;
            }
            Text {
                text: root.mode == "fan" ? @tr("Fan") : root.temp + "°";
                color: root.power ? Theme.fg : Theme.muted;
                font-size: 112px;
                horizontal-alignment: right;
            }
        }
        if !root.power-only: Divider { }
        if !root.power-only: HorizontalLayout {
            height: 72px;
            spacing: Theme.gap;
            Key { has-icon: true; icon: @image-url("icons/power.svg"); kind: root.power ? KeyKind.primary : KeyKind.number; long-press-enabled: true; clicked => { root.action("power"); } long-pressed => { root.import-key = "power"; } }
            LearnKey { unlearned: root.nec && !root.learned.mode; label: root.mode == "cool" ? @tr("Cool") : root.mode == "fan" ? @tr("Fan") : root.mode == "dry" ? @tr("Dry") : root.mode == "heat" ? @tr("Heat") : @tr("Auto"); font-size: 18px; long-press-enabled: true; clicked => { root.action("mode"); } long-pressed => { root.import-key = "mode"; } }
            LearnKey { unlearned: root.nec && !root.learned.fan; has-icon: true; icon: @image-url("icons/fan.svg"); long-press-enabled: true; clicked => { root.action("fan"); } long-pressed => { root.import-key = "fan"; } }
        }
        if !root.power-only: HorizontalLayout {
            spacing: Theme.gap;
            vertical-stretch: 1;
            min-height: 150px;
            LearnKey { unlearned: root.nec && !root.learned.cooler; label: "−"; kind: KeyKind.operator; font-size: 44px; long-press-enabled: true; clicked => { root.action("cooler"); } long-pressed => { root.import-key = "cooler"; } }
            LearnKey { unlearned: root.nec && !root.learned.warmer; label: "+"; kind: KeyKind.operator; font-size: 44px; long-press-enabled: true; clicked => { root.action("warmer"); } long-pressed => { root.import-key = "warmer"; } }
        }
        if !root.power-only: HorizontalLayout {
            height: 72px;
            spacing: Theme.gap;
            // Per-key remotes send their learned Timer key; protocol ACs open the timer.
            Toggle {
                unlearned: root.nec && !root.learned.timer;
                has-icon: true;
                icon: @image-url("icons/timer.svg");
                on: root.timer-left > 0;
                long-press-enabled: true;
                clicked => {
                    if root.nec || root.learned.timer { root.action("timer"); } else { root.timer-open = true; }
                }
                long-pressed => { root.import-key = "timer"; }
            }
            Toggle { unlearned: root.nec && !root.learned.sleep; has-icon: true; icon: @image-url("icons/sleep.svg"); on: root.sleep; long-press-enabled: true; clicked => { root.action("sleep"); } long-pressed => { root.import-key = "sleep"; } }
            Toggle { unlearned: root.nec && !root.learned.swing; has-icon: true; icon: @image-url("icons/swing.svg"); on: root.swing; long-press-enabled: true; clicked => { root.action("swing"); } long-pressed => { root.import-key = "swing"; } }
        }
    }
    if root.scan-active || root.scan-finished || root.scan-review: NecScanOverlay {
        learning: root.learning == "mode" ? @tr("mode")
            : root.learning == "fan" ? @tr("fan")
            : root.learning == "cooler" ? "−"
            : root.learning == "warmer" ? "+"
            : root.learning == "timer" ? @tr("timer")
            : root.learning == "sleep" ? @tr("sleep")
            : root.learning == "swing" ? @tr("swing")
            : root.learning;
        scan-active: root.scan-active;
        scan-finished: root.scan-finished;
        scan-cancelled: root.scan-cancelled;
        scan-count: root.scan-count;
        scan-total: root.scan-total;
        scan-index: root.scan-index;
        scan-review: root.scan-review;
        scan-code: root.scan-code;
        scan-result: root.scan-result;
        setup(step) => { root.setup(step); }
        scan-cancel => { root.scan-cancel(); }
        scan-navigate(d) => { root.scan-navigate(d); }
    }
    if root.timer-open: TimerSheet {
        supported: root.timer-supported;
        step: root.timer-step;
        longest: root.timer-max;
        left: root.timer-left;
        timer-on: root.timer-on;
        power: root.power;
        set(m) => { root.set-timer(m); }
        close => { root.timer-open = false; }
    }
    if root.import-key != "": ImportSheet {
        key-label: root.key-label(root.import-key);
        error: root.import-error;
        import(text) => { root.import(root.import-key, text); }
        close => { root.import-key = ""; root.import-error = ""; }
    }
}

// 05 · AC setup. The phone can't listen to IR, so we try each protocol until the AC beeps.
export component AcSetupPage inherits Rectangle {
    in property <string> protocol;
    in property <string> setup-error;
    in property <int> index;
    in property <int> count;
    in property <bool> tested;
    in property <bool> scan-active;
    in property <bool> scan-finished;
    in property <bool> scan-cancelled;
    in property <int> scan-count;
    in property <int> scan-total;
    in-out property <int> scan-index;
    in-out property <bool> scan-review;
    in property <string> scan-code;
    in property <string> scan-result;
    callback menu;
    callback setup(string);
    callback scan-cancel();
    callback scan-navigate(int);
    callback code-changed(string);
    // The on-screen keyboard, in window coordinates; while pasting a code, its row rides just above it.
    in property <length> kb-top;
    in property <length> kb-height;
    property <bool> lifted: field.has-focus && root.kb-height > 0;
    property <length> bar-y: root.lifted ? min(slot.y, root.kb-top - root.absolute-position.y - 56px - 10px) : slot.y;
    property <bool> scan-warning;

    VerticalLayout {
        spacing: Theme.gap;
        Header { title: @tr("New air conditioner"); subtitle: @tr("Point your phone at it"); menu => { root.menu(); } }
        VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 14px;
            spacing: 4px;
            Text { text: @tr("Code {} of {}", root.index + 1, root.count); color: Theme.muted; font-size: 19px; }
            Text {
                text: root.setup-error != "" ? @tr("Invalid infrared code: {}", root.setup-error) : root.protocol;
                color: Theme.fg;
                font-size: root.setup-error != "" ? 18px : 76px;
                horizontal-alignment: right;
                overflow: elide;
                wrap: word-wrap;
            }
        }
        Divider { }
        Text {
            x: 8px;
            width: parent.width - 16px;
            wrap: word-wrap;
            color: Theme.muted;
            font-size: 16px;
            text: root.tested
                ? @tr("Did it beep or switch on? If so, tap \"It works\". If not, try the next code.")
                : @tr("Turn the AC off, point the top of your phone at it from a couple of meters, and tap Test. It sends the code a few times and should switch on in cool mode at 22°.");
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            height: 72px;
            spacing: Theme.gap;
            Key { label: @tr("Test"); font-size: 19px; clicked => { root.setup("test"); } }
            Key { label: @tr("Next"); kind: KeyKind.operator; font-size: 19px; clicked => { root.setup("next"); } }
            Key { label: @tr("Auto scan"); kind: KeyKind.operator; font-size: 17px; clicked => { root.scan-warning = true; } }
        }
        // Where the pasted-code row sits until the keyboard lifts it.
        slot := Rectangle { height: 56px; }
        Key { height: 72px; label: @tr("It works"); kind: KeyKind.primary; font-size: 20px; clicked => { root.setup("ok"); } }
    }

    // A clean strip of page color behind the lifted row, so the page doesn't show through.
    if root.lifted: Rectangle {
        y: root.bar-y - 14px;
        height: root.height - self.y + 40px;
        background: Theme.bg;
        Rectangle { y: 0; height: 1px; background: Theme.divider; }
    }
    HorizontalLayout {
        y: root.bar-y;
        height: 56px;
        animate y { duration: 160ms; easing: ease-out; }
        spacing: Theme.gap;
        Rectangle {
            horizontal-stretch: 3;
            border-radius: Theme.radius;
            background: Theme.key;
            border-width: 1px;
            border-color: Theme.key-border;
            clip: true;
            field := TextInput {
                x: 14px;
                width: parent.width - 28px;
                color: Theme.fg;
                font-size: 14px;
                vertical-alignment: center;
                single-line: true;
                edited => { root.code-changed(self.text); }
                accepted => { root.setup("code"); }
            }
            if field.text == "": Text {
                x: 14px;
                width: parent.width - 28px;
                text: @tr("Paste a Pronto, raw, Flipper or LIRC code for a unit no code above reaches");
                color: Theme.muted;
                font-size: 14px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Key { horizontal-stretch: 1; label: @tr("Test code"); font-size: 15px; clicked => { root.setup("code"); } }
    }
    if root.scan-warning: Confirm {
        title: @tr("Warning before NEC auto-test");
        message: @tr("The 675-code sweep sends many infrared commands and can take several minutes. Nearby TVs, soundbars, set-top boxes, or other IR devices may react or change state. Point the phone only at your AC and be ready to stop the scan.");
        action: @tr("Start scan");
        confirmed => { root.scan-warning = false; root.setup("scan-confirm"); }
        cancelled => { root.scan-warning = false; }
    }
    if root.scan-active || root.scan-finished || root.scan-review: NecScanOverlay {
        scan-active: root.scan-active;
        scan-finished: root.scan-finished;
        scan-cancelled: root.scan-cancelled;
        scan-count: root.scan-count;
        scan-total: root.scan-total;
        scan-index: root.scan-index;
        scan-review: root.scan-review;
        scan-code: root.scan-code;
        scan-result: root.scan-result;
        setup(step) => { root.setup(step); }
        scan-cancel => { root.scan-cancel(); }
        scan-navigate(d) => { root.scan-navigate(d); }
    }
}
